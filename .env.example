# Local WSGI server. Copy this file to .env.local; .env.local is gitignored.
HOST=127.0.0.1
PORT=3000

# Public reads are RLS-bound and may use the checked-in browser-safe fallback.
# Set these only when testing a different Development/Preview Supabase project.
# Never put a service-role key in browser code or a NEXT_PUBLIC_/VITE_ variable.
# SUPABASE_URL=https://YOUR-DEVELOPMENT-PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# Phase 1 is OFF until migration + reviewed publication have been completed.
# Emergency rollback only. Omit in normal deployments; set to 0 to disable.
# TEI_ENTITY_API_ENABLED=0
# Optional isolated Supabase project for public entity reads.
# TEI_ENTITY_SUPABASE_URL=https://YOUR-PREVIEW-PROJECT.supabase.co
# TEI_ENTITY_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Authenticated Workspace/Watchlist writes are disabled unless this explicit,
# paired configuration targets the intended environment. Preview must use an
# isolated non-Production project. Never reuse Production values in Preview.
# TEI_PRIVATE_SUPABASE_URL=https://YOUR-PREVIEW-PROJECT.supabase.co
# TEI_PRIVATE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Backfill only: explicitly select destination, and supply the key in the server environment.
# TEI_BACKFILL_SUPABASE_URL=https://YOUR-PREVIEW-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SERVER-ONLY-NEVER-IN-BROWSER

# Optional official Judicial Yuan credentials for live source sync only.
# JUDICIAL_USER=
# JUDICIAL_PASSWORD=
